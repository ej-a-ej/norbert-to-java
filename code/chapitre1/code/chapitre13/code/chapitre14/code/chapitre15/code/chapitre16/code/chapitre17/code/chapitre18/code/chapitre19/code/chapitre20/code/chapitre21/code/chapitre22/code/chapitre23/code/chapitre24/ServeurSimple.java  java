import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.io.OutputStream;
import java.net.ServerSocket;
import java.net.Socket;

public class ServeurSimple {
    
    public void demarrer() {
        System.out.println("🚀 Serveur Lya sur le port 8080...");
        
        try {
            ServerSocket serveur = new ServerSocket(8080);
            System.out.println("✅ En attente de connexions...");
            
            while (true) {
                Socket client = serveur.accept();
                System.out.println("📱 Nouvelle connexion !");
                
                BufferedReader entree = new BufferedReader(
                    new InputStreamReader(client.getInputStream())
                );
                
                String ligne = entree.readLine();
                if (ligne != null) {
                    System.out.println("📤 Requête : " + ligne);
                    String reponse = traiterDemande(ligne);
                    
                    OutputStream sortie = client.getOutputStream();
                    sortie.write(("HTTP/1.1 200 OK\n\n" + reponse).getBytes());
                }
                
                client.close();
                System.out.println("📱 Client déconnecté.\n");
            }
        } catch (Exception e) {
            System.out.println("❌ Erreur : " + e.getMessage());
        }
    }
    
    private String traiterDemande(String ligne) {
        String[] parts = ligne.split(" ");
        if (parts.length < 2) return "Demande invalide";
        String chemin = parts[1];
        
        if (chemin.equals("/") || chemin.equals("/bonjour")) {
            return "👋 Bonjour ! Je suis Lya. Comment puis-je t'aider ?";
        } else if (chemin.startsWith("/meteo/")) {
            String ville = chemin.substring(7);
            return ServiceMeteo.getMeteo(ville);
        } else if (chemin.equals("/aide")) {
            return "📚 Commandes : /bonjour, /meteo/Ville, /aide";
        } else {
            return "❌ Commande inconnue : " + chemin + ". Essaie /aide";
        }
    }
    
    public static void main(String[] args) {
        ServeurSimple serveur = new ServeurSimple();
        serveur.demarrer();
    }
}
